{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Itens do Aika",
  "version": "0.1.0",
  "identifier": "com.londarks.aika.visualizador",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Itens do Aika",
        "width": 1240,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}