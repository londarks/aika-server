# Copy to `.env` and fill in. `.env` is ignored by git; this file is not, so
# nothing here may be real.
#
# The database the server connects to. Wins over `url` in config.toml, which
# wins over `path`. Leave it unset to use the SQLite file under var/.
AIKA_DATABASE_URL=mysql://user:password@host:3306/database

# Log every packet in and out as it happens. The per-connection ring is
# dumped on its own when a client stops talking; this is for watching.
# AIKA_TRACE=1
